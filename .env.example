# ============================================
# AI Price Predictor - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase (REQUIRED) ---
# Create free account: https://supabase.com
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co
# Project Settings → API → anon public key
SUPABASE_KEY=your-anon-key-here
# Project Settings → API → service_role key (Keep SECRET, server-only)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- ScraperAPI (OPTIONAL, for better scraping) ---
# Free tier: 1000 requests/month. Get key at: https://www.scraperapi.com
SCRAPERAPI_KEY=

# --- Telegram Bot (OPTIONAL, for phone alerts) ---
# Get token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# --- Gmail SMTP (OPTIONAL, for email alerts) ---
# Use an App Password (NOT your regular password):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- App URL ---
# Your deployed Streamlit Cloud URL (no trailing slash)
APP_URL=http://localhost:8501